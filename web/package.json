{
  "name": "web",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "prisma generate && next build && esbuild server.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "antd": "^6.6.7",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.2.13",
    "@line/bot-sdk": "^10.8.0",
    "next": "^16.4.2",
    "@next/env": "^16.4.2",
    "prisma": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "@tanstack/react-query": "^5.104.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

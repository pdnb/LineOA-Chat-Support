# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linecc

# HTTP
PORT=3000
# Public HTTPS base URL — used for LINE image URLs and job callback URLs.
# `npm run tunnel` (Cloudflare quick tunnel) writes this automatically; with ngrok set it yourself.
PUBLIC_BASE_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=12h

# Auth0 (optional, leave empty to hide the "เข้าสู่ระบบด้วย Auth0" button). Regular Web Application:
# Allowed Callback URL = PUBLIC_BASE_URL/api/auth/auth0/callback, Allowed Logout URL = PUBLIC_BASE_URL/login
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# LINE OAs are managed on the admin page "บัญชี LINE OA". These legacy values are copied once
# into the default OA on startup when it has no credentials yet (leave empty for the console stub client).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Auto-assign handed-off chats to the least busy online agent
AUTO_ASSIGN=false

# Queue worker
QUEUE_POLL_MS=500
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000

# Seed (dev only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
SEED_INTEGRATION_URL=http://localhost:4001/jobs
SEED_INTEGRATION_SECRET=dev-integration-secret
